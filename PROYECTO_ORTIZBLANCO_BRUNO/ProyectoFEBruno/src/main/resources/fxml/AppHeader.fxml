<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Componente visual reutilizable: cabecera de pantalla.
    Logo del centro + título de la pantalla + información del usuario + acción primaria.
    Se incluye con <fx:include source="AppHeader.fxml" fx:id="appHeader"/>
    El controlador padre puede acceder al controlador inyectado como appHeaderController
    para fijar el título, la info del usuario y la acción del botón.
-->
<HBox xmlns="http://javafx.com/javafx/8.0.72"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.brunob.ProyectoBase2025.controller.AppHeaderController"
      alignment="CENTER_LEFT" spacing="20.0" styleClass="header-panel">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
    </padding>
    <children>
        <ImageView fitWidth="60.0" fitHeight="60.0" preserveRatio="true">
            <image>
                <Image url="@../images/logoLaboral.jpg"/>
            </image>
        </ImageView>
        <VBox spacing="5.0">
            <Label fx:id="lblTitulo" text="" styleClass="title-header"/>
            <Label fx:id="lblUserInfo" text="Usuario: " styleClass="subtitle-header"/>
        </VBox>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAccion" text="Volver al Menú" styleClass="btn-secondary"/>
    </children>
</HBox>
