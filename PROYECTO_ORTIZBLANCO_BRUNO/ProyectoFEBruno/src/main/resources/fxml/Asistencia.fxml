<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/8.0.72"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.brunob.ProyectoBase2025.controller.AsistenciaController"
            stylesheets="@../styles/Menu.css">
   <top>
      <VBox>
         <MenuBar styleClass="menu-bar">
            <menus>
               <Menu text="Archivo">
                  <items>
                     <MenuItem text="Volver al Menú" onAction="#volverMenu"/>
                     <MenuItem text="Cerrar Sesión" onAction="#logout"/>
                     <MenuItem text="Salir" onAction="#exit"/>
                  </items>
               </Menu>
               <Menu text="Ayuda">
                  <items>
                     <MenuItem text="Ayuda" accelerator="F1" onAction="#mostrarAyuda"/>
                     <MenuItem text="Acerca de" onAction="#acercaDe"/>
                  </items>
               </Menu>
            </menus>
         </MenuBar>

         <fx:include source="/dev/brunob/componentes/ui/fxml/AppHeader.fxml" fx:id="appHeader"/>
      </VBox>
   </top>

   <left>
      <VBox prefWidth="360.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="10.0" top="20.0"/>
         </padding>
         <children>
            <Label text="Estudiantes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblScope" text="" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" wrapText="true"/>
            <TableView fx:id="estudiantesTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="colEstId" prefWidth="55.0" text="ID"/>
                  <TableColumn fx:id="colEstNombre" prefWidth="170.0" text="Nombre"/>
                  <TableColumn fx:id="colEstCurso" prefWidth="125.0" text="Curso"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="20.0"/>
         </padding>
         <children>
            <Label text="Historial de asistencias" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="historialTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="colFecha" prefWidth="110.0" text="Fecha"/>
                  <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado"/>
                  <TableColumn fx:id="colJustificada" prefWidth="120.0" text="Justificada"/>
                  <TableColumn fx:id="colMotivo" prefWidth="280.0" text="Motivo / Observaciones"/>
                  <TableColumn fx:id="colAutor" prefWidth="160.0" text="Registrado por"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>

   <right>
      <VBox prefWidth="350.0" spacing="10.0"
            style="-fx-background-color: white; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 3);"
            BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <BorderPane.margin>
            <Insets bottom="20.0" right="20.0" top="20.0"/>
         </BorderPane.margin>
         <children>
            <Label text="Registrar asistencia" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Separator/>

            <Label text="Estudiante" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <Label fx:id="lblEstudianteSel" text="—" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Label text="Fecha" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308"/>

            <CheckBox fx:id="chkPresente" text="Presente" selected="true"/>
            <CheckBox fx:id="chkJustificada" text="Falta justificada"/>

            <Label text="Motivo / Observaciones" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <TextArea fx:id="txtMotivo" promptText="Justificación, observaciones..."
                      prefRowCount="6" wrapText="true"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <VBox.margin>
                  <Insets top="5.0"/>
               </VBox.margin>
               <children>
                  <Button fx:id="btnLimpiar" text="Limpiar" onAction="#reset" styleClass="button-warning" minWidth="-Infinity"/>
                  <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="button-danger" minWidth="-Infinity"/>
                  <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" styleClass="button-success" minWidth="-Infinity"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </right>

   <bottom>
      <fx:include source="/dev/brunob/componentes/ui/fxml/AppFooter.fxml"/>
   </bottom>
</BorderPane>

