<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/8.0.72"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.brunob.ProyectoBase2025.controller.DocumentoController"
            stylesheets="@../styles/Menu.css">
   <top>
      <VBox>
         <MenuBar styleClass="menu-bar">
            <menus>
               <Menu text="Archivo">
                  <items>
                     <MenuItem text="Volver al Menú" onAction="#volverMenu"/>
                     <MenuItem text="Cerrar Sesión" onAction="#logout"/>
                     <MenuItem text="Salir" onAction="#exit"/>
                  </items>
               </Menu>
               <Menu text="Ayuda">
                  <items>
                     <MenuItem text="Ayuda" accelerator="F1" onAction="#mostrarAyuda"/>
                     <MenuItem text="Acerca de" onAction="#acercaDe"/>
                  </items>
               </Menu>
            </menus>
         </MenuBar>

         <fx:include source="/dev/brunob/componentes/ui/fxml/AppHeader.fxml" fx:id="appHeader"/>
      </VBox>
   </top>

   <left>
      <VBox prefWidth="380.0" spacing="10.0"
            style="-fx-background-color: white; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 3);"
            BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" top="20.0"/>
         </BorderPane.margin>
         <children>
            <Label text="Detalles del Documento"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
               <VBox.margin>
                  <Insets bottom="5.0"/>
               </VBox.margin>
            </Label>
            <Separator/>

            <Label text="Formación en empresa" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="cbFormacion" promptText="Seleccionar formación" maxWidth="1.7976931348623157E308"/>

            <Label text="Nombre" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <TextField fx:id="txtNombre" promptText="Nombre del documento"/>

            <Label text="Tipo" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="cbTipo" promptText="Tipo" editable="true" maxWidth="1.7976931348623157E308"/>

            <Label text="Archivo" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <HBox spacing="5.0">
               <children>
                  <TextField fx:id="txtRuta" promptText="Ruta del archivo" HBox.hgrow="ALWAYS"/>
                  <Button fx:id="btnExaminar" text="..." onAction="#examinar" styleClass="button-info" minWidth="-Infinity"/>
               </children>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <VBox.margin>
                  <Insets top="10.0"/>
               </VBox.margin>
               <children>
                  <Button fx:id="btnAbrir" text="Abrir" onAction="#abrir" styleClass="button-info" minWidth="-Infinity"/>
                  <Button fx:id="btnLimpiar" text="Limpiar" onAction="#reset" styleClass="button-warning" minWidth="-Infinity"/>
                  <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="button-danger" minWidth="-Infinity"/>
                  <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" styleClass="button-success" minWidth="-Infinity"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </left>

   <center>
      <VBox alignment="TOP_CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <children>
            <Label fx:id="lblScopeInfo" text="" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" wrapText="true"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Buscar:" style="-fx-font-weight: bold;"/>
                  <TextField fx:id="txtBuscar" promptText="Nombre / estudiante / empresa" prefWidth="280.0"/>
                  <Label text="Tipo:"/>
                  <ComboBox fx:id="cbFiltroTipo" prefWidth="180.0" promptText="Todos los tipos"/>
                  <HBox HBox.hgrow="ALWAYS"/>
                  <Button text="Refrescar" onAction="#refresh" styleClass="button-info"/>
               </children>
            </HBox>

            <Separator/>

            <Label text="Lista de Documentos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="documentosTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                  <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre"/>
                  <TableColumn fx:id="colTipo" prefWidth="120.0" text="Tipo"/>
                  <TableColumn fx:id="colEstudiante" prefWidth="170.0" text="Estudiante"/>
                  <TableColumn fx:id="colEmpresa" prefWidth="160.0" text="Empresa"/>
                  <TableColumn fx:id="colSubidoPor" prefWidth="150.0" text="Subido por"/>
                  <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>

   <bottom>
      <fx:include source="/dev/brunob/componentes/ui/fxml/AppFooter.fxml"/>
   </bottom>
</BorderPane>

