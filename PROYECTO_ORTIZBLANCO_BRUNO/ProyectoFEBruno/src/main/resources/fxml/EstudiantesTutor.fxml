<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/8.0.72"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.brunob.ProyectoBase2025.controller.EstudiantesTutorController"
            stylesheets="@../styles/Menu.css">
   <top>
      <VBox>
         <MenuBar styleClass="menu-bar">
            <menus>
               <Menu text="Archivo">
                  <items>
                     <MenuItem text="Volver al Menú" onAction="#volverMenu"/>
                     <MenuItem text="Cerrar Sesión" onAction="#logout"/>
                     <MenuItem text="Salir" onAction="#exit"/>
                  </items>
               </Menu>
               <Menu text="Ayuda">
                  <items>
                     <MenuItem text="Ayuda" accelerator="F1" onAction="#mostrarAyuda"/>
                     <MenuItem text="Acerca de" onAction="#acercaDe"/>
                  </items>
               </Menu>
            </menus>
         </MenuBar>

         <fx:include source="/dev/brunob/componentes/ui/fxml/AppHeader.fxml" fx:id="appHeader"/>
      </VBox>
   </top>

   <center>
      <VBox alignment="TOP_CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <children>
            <Label text="Estudiantes asignados a su tutoría" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblScope" text="" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <TableView fx:id="estudiantesTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
                  <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre"/>
                  <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email"/>
                  <TableColumn fx:id="colCurso" prefWidth="180.0" text="Curso"/>
                  <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado FE"/>
                  <TableColumn fx:id="colPeriodo" prefWidth="200.0" text="Periodo"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>

   <bottom>
      <fx:include source="/dev/brunob/componentes/ui/fxml/AppFooter.fxml"/>
   </bottom>
</BorderPane>

