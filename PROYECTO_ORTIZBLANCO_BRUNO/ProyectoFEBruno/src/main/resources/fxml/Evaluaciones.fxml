<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/8.0.72"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.brunob.ProyectoBase2025.controller.EvaluacionController"
            stylesheets="@../styles/Menu.css">
   <top>
      <VBox>
         <MenuBar styleClass="menu-bar">
            <menus>
               <Menu text="Archivo">
                  <items>
                     <MenuItem text="Volver al Menú" onAction="#volverMenu"/>
                     <MenuItem text="Cerrar Sesión" onAction="#logout"/>
                     <MenuItem text="Salir" onAction="#exit"/>
                  </items>
               </Menu>
               <Menu text="Ayuda">
                  <items>
                     <MenuItem text="Acerca de" onAction="#acercaDe"/>
                  </items>
               </Menu>
            </menus>
         </MenuBar>

         <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-panel">
            <padding>
               <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>
            <children>
               <ImageView fitWidth="60.0" fitHeight="60.0" preserveRatio="true">
                  <image>
                     <Image url="@../images/logoLaboral.jpg"/>
                  </image>
               </ImageView>
               <VBox spacing="5.0">
                  <Label text="Evaluación y Supervisión de Estudiantes" styleClass="title-header"/>
                  <Label fx:id="lblUserInfo" text="Usuario: " styleClass="subtitle-header"/>
               </VBox>
               <HBox HBox.hgrow="ALWAYS"/>
               <Button text="Volver al Menú" onAction="#volverMenu" styleClass="btn-logout"/>
            </children>
         </HBox>
      </VBox>
   </top>

   <left>
      <VBox prefWidth="380.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="10.0" top="20.0"/>
         </padding>
         <children>
            <Label text="Estudiantes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblScopeInfo" text="" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" wrapText="true"/>
            <TableView fx:id="estudiantesTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="colEstId" prefWidth="50.0" text="ID"/>
                  <TableColumn fx:id="colEstNombre" prefWidth="170.0" text="Nombre"/>
                  <TableColumn fx:id="colEstCurso" prefWidth="140.0" text="Curso"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
            </TableView>

            <Separator/>
            <Label text="Ficha del estudiante" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblFichaNombre" text="—" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblFichaEmail" text="" style="-fx-font-size: 12px; -fx-text-fill: #34495e;"/>
            <Label fx:id="lblFichaCurso" text="" style="-fx-font-size: 12px; -fx-text-fill: #34495e;"/>
            <Label fx:id="lblFichaFE" text="" style="-fx-font-size: 12px; -fx-text-fill: #34495e;" wrapText="true"/>
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="20.0"/>
         </padding>
         <children>
            <Label text="Historial de evaluaciones" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="evaluacionesTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="colEvFecha" prefWidth="100.0" text="Fecha"/>
                  <TableColumn fx:id="colEvTutor" prefWidth="160.0" text="Tutor"/>
                  <TableColumn fx:id="colEvActitud" prefWidth="70.0" text="Actitud"/>
                  <TableColumn fx:id="colEvPuntualidad" prefWidth="90.0" text="Puntualidad"/>
                  <TableColumn fx:id="colEvCompetencias" prefWidth="100.0" text="Competencias"/>
                  <TableColumn fx:id="colEvValoracion" prefWidth="90.0" text="Valoración"/>
                  <TableColumn fx:id="colEvObs" prefWidth="240.0" text="Observaciones"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>

   <right>
      <VBox prefWidth="360.0" spacing="10.0"
            style="-fx-background-color: white; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 3);"
            BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <BorderPane.margin>
            <Insets bottom="20.0" right="20.0" top="20.0"/>
         </BorderPane.margin>
         <children>
            <Label text="Nueva evaluación"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Separator/>

            <Label text="Estudiante seleccionado" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <Label fx:id="lblEstudianteSel" text="—"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Label text="Fecha" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308"/>

            <HBox spacing="10.0">
               <children>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <Label text="Actitud (1-5)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                     <ComboBox fx:id="cbActitud" maxWidth="1.7976931348623157E308"/>
                  </VBox>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <Label text="Puntualidad (1-5)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                     <ComboBox fx:id="cbPuntualidad" maxWidth="1.7976931348623157E308"/>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="10.0">
               <children>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <Label text="Competencias (1-5)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                     <ComboBox fx:id="cbCompetencias" maxWidth="1.7976931348623157E308"/>
                  </VBox>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <Label text="Valoración general (1-5)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                     <ComboBox fx:id="cbValoracion" maxWidth="1.7976931348623157E308"/>
                  </VBox>
               </children>
            </HBox>

            <Label text="Observaciones" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <TextArea fx:id="txtObservaciones" promptText="Actitud, puntualidad, competencias adquiridas, etc."
                      prefRowCount="5" wrapText="true"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <VBox.margin>
                  <Insets top="5.0"/>
               </VBox.margin>
               <children>
                  <Button fx:id="btnLimpiar" text="Limpiar" onAction="#reset" styleClass="button-warning" minWidth="-Infinity"/>
                  <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="button-danger" minWidth="-Infinity"/>
                  <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" styleClass="button-success" minWidth="-Infinity"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </right>

   <bottom>
      <HBox alignment="CENTER" spacing="300.0" styleClass="footer-panel">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
         <children>
            <Label text="Sistema de Gestión FE - CIFP La Laboral v1.0"/>
            <Label text="Bruno Ortiz Blanco"/>
         </children>
      </HBox>
   </bottom>
</BorderPane>
