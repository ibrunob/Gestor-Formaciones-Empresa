<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/8.0.72"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.brunob.ProyectoBase2025.controller.FormacionEmpresaController"
            stylesheets="@../styles/Menu.css">
   <top>
      <VBox>
         <MenuBar styleClass="menu-bar">
            <menus>
               <Menu text="Archivo">
                  <items>
                     <MenuItem text="Volver al Menú" onAction="#volverMenu"/>
                     <MenuItem text="Cerrar Sesión" onAction="#logout"/>
                     <MenuItem text="Salir" onAction="#exit"/>
                  </items>
               </Menu>
               <Menu text="Edición">
                  <items>
                     <MenuItem text="Eliminar Formación" onAction="#deleteFormaciones"/>
                     <MenuItem text="Limpiar Formulario" onAction="#reset"/>
                  </items>
               </Menu>
               <Menu text="Ayuda">
                  <items>
                     <MenuItem text="Ayuda" accelerator="F1" onAction="#mostrarAyuda"/>
                     <MenuItem text="Acerca de" onAction="#acercaDe"/>
                  </items>
               </Menu>
            </menus>
         </MenuBar>

         <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-panel">
            <padding>
               <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>
            <children>
               <ImageView fitWidth="60.0" fitHeight="60.0" preserveRatio="true">
                  <image>
                     <Image url="@../images/logoLaboral.jpg"/>
                  </image>
               </ImageView>
               <VBox spacing="5.0">
                  <Label text="Gestión de Formación en Empresa" styleClass="title-header"/>
                  <Label fx:id="lblUserInfo" text="Usuario: " styleClass="subtitle-header"/>
               </VBox>
               <HBox HBox.hgrow="ALWAYS"/>
               <Button text="Volver al Menú" onAction="#volverMenu" styleClass="btn-logout"/>
            </children>
         </HBox>
      </VBox>
   </top>
   <left>
      <VBox prefWidth="340.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 3);" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" top="20.0"/>
         </BorderPane.margin>
         <children>
            <Label text="Datos de la Formación" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
               <VBox.margin>
                  <Insets bottom="10.0"/>
               </VBox.margin>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="ID Formación:" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                  <Label fx:id="formacionId" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
               </children>
            </HBox>

            <Label text="Estudiante" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="cbEstudiante" promptText="Seleccionar Estudiante" maxWidth="1.7976931348623157E308"/>

            <Label text="Profesor (Tutor Docente)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="cbProfesor" promptText="Seleccionar Profesor" maxWidth="1.7976931348623157E308"/>

            <Label text="Tutor de Empresa" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="cbTutor" promptText="Seleccionar Tutor de Empresa" maxWidth="1.7976931348623157E308"/>

            <Label text="Empresa" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <Label fx:id="lblEmpresa" text="—" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-background-color: #f4f6f8; -fx-background-radius: 6px; -fx-padding: 8 12 8 12;" maxWidth="1.7976931348623157E308"/>

            <Label text="Curso Académico" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="cbCurso" promptText="Seleccionar Curso" maxWidth="1.7976931348623157E308"/>

            <HBox spacing="10.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <Label text="Fecha Inicio" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                     <DatePicker fx:id="fechaInicio" promptText="Inicio" maxWidth="1.7976931348623157E308"/>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <Label text="Fecha Fin" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                     <DatePicker fx:id="fechaFin" promptText="Fin" maxWidth="1.7976931348623157E308"/>
                  </VBox>
               </children>
            </HBox>

            <Label text="Estado" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="cbEstado" promptText="Seleccionar Estado" maxWidth="1.7976931348623157E308"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <VBox.margin>
                  <Insets top="10.0"/>
               </VBox.margin>
               <children>
                  <Button fx:id="reset" text="Limpiar" onAction="#reset" styleClass="button-warning"/>
                  <Button fx:id="saveFormacion" text="Guardar" onAction="#saveFormacion" styleClass="button-success"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   <center>
      <VBox alignment="TOP_CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <children>
            <Label text="Lista de Formaciones en Empresa" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="formacionTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                  <TableColumn fx:id="colEstudiante" prefWidth="160.0" text="Estudiante"/>
                  <TableColumn fx:id="colEmpresa" prefWidth="140.0" text="Empresa"/>
                  <TableColumn fx:id="colProfesor" prefWidth="140.0" text="Profesor"/>
                  <TableColumn fx:id="colTutor" prefWidth="140.0" text="Tutor Empresa"/>
                  <TableColumn fx:id="colCurso" prefWidth="120.0" text="Curso"/>
                  <TableColumn fx:id="colFechaInicio" prefWidth="100.0" text="Inicio"/>
                  <TableColumn fx:id="colFechaFin" prefWidth="100.0" text="Fin"/>
                  <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado"/>
                  <TableColumn fx:id="colEdit" prefWidth="70.0" text="Editar"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
               <contextMenu>
                  <ContextMenu>
                     <items>
                        <MenuItem fx:id="deleteFormaciones" onAction="#deleteFormaciones" text="Eliminar"/>
                     </items>
                  </ContextMenu>
               </contextMenu>
            </TableView>
         </children>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER" spacing="300.0" styleClass="footer-panel">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
         <children>
            <Label text="Sistema de Gestión FE - CIFP La Laboral v1.0"/>
            <Label text="Bruno Ortiz Blanco"/>
         </children>
      </HBox>
   </bottom>
</BorderPane>
