<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" minHeight="560.0" minWidth="820.0"
            style="-fx-background-color: linear-gradient(to bottom, #1e3c72, #2a5298);"
            xmlns="http://javafx.com/javafx/8.0.72"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.brunob.ProyectoBase2025.controller.LoginController">

    <top>
        <HBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="18.0" left="20.0" right="20.0" top="24.0"/>
            </padding>
            <children>
                <ImageView fitWidth="72.0" fitHeight="72.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/logoLaboral.jpg"/>
                    </image>
                </ImageView>

                <VBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="CIFP La Laboral Gijón" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="22.0"/>
                        </font>
                    </Label>
                    <Label text="Departamento de Informática y Comunicaciones" textFill="#cccccc">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </Label>
                </VBox>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="14.0" maxWidth="420.0" fillWidth="true">
            <padding>
                <Insets bottom="12.0" left="40.0" right="40.0" top="8.0"/>
            </padding>
            <children>
                <Label text="Inicio de Sesión" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>

                <Label text="Ingrese sus credenciales para continuar" textFill="#cccccc" wrapText="true">
                    <font>
                        <Font size="14.0"/>
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0"/>
                    </VBox.margin>
                </Label>

                <VBox spacing="8.0" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                    <Label text="Usuario" textFill="WHITE">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </Label>
                    <TextField fx:id="username" promptText="Ingrese su usuario"
                               onAction="#login"
                               prefWidth="360.0" prefHeight="58.0" maxWidth="1.7976931348623157E308"
                               style="-fx-background-color: rgba(255,255,255,0.94); -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-font-size: 15px; -fx-padding: 6 16 6 16;"/>
                </VBox>

                <VBox spacing="8.0" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                    <Label text="Contraseña" textFill="WHITE">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </Label>
                    <StackPane maxWidth="1.7976931348623157E308">
                        <children>
                            <PasswordField fx:id="password" promptText="Ingrese su contraseña"
                                           onAction="#login"
                                       prefWidth="360.0" prefHeight="58.0" maxWidth="1.7976931348623157E308"
                                       style="-fx-background-color: rgba(255,255,255,0.94); -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-font-size: 15px; -fx-padding: 6 52 6 16;"/>
                            <TextField fx:id="visiblePassword" promptText="Ingrese su contraseña"
                                       onAction="#login"
                                       prefWidth="360.0" prefHeight="58.0" maxWidth="1.7976931348623157E308"
                                       visible="false" managed="false"
                                       style="-fx-background-color: rgba(255,255,255,0.94); -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-font-size: 15px; -fx-padding: 6 52 6 16;"/>
                            <Button fx:id="btnTogglePassword"
                                    text=""
                                    onAction="#togglePasswordVisibility"
                                    prefWidth="44.0" prefHeight="44.0" maxWidth="44.0" minWidth="44.0"
                                    focusTraversable="false"
                                    StackPane.alignment="CENTER_RIGHT"
                                    style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10 0 10; -fx-cursor: hand;">
                                <StackPane.margin>
                                    <Insets right="6.0"/>
                                </StackPane.margin>
                                <graphic>
                                    <StackPane>
                                        <children>
                                            <SVGPath content="M1.5,12 C4.3,7.5 8.1,5.3 12,5.3 C15.9,5.3 19.7,7.5 22.5,12 C19.7,16.5 15.9,18.7 12,18.7 C8.1,18.7 4.3,16.5 1.5,12 Z M12,8.2 C9.9,8.2 8.2,9.9 8.2,12 C8.2,14.1 9.9,15.8 12,15.8 C14.1,15.8 15.8,14.1 15.8,12 C15.8,9.9 14.1,8.2 12,8.2 Z"
                                                     fill="#5f6b7a" scaleX="0.8" scaleY="0.8"/>
                                            <SVGPath fx:id="passwordToggleSlash"
                                                     content="M18.3,4.8 L19.8,6.3 L5.7,20.4 L4.2,18.9 Z"
                                                     fill="#5f6b7a" visible="false" managed="false"
                                                     scaleX="0.8" scaleY="0.8"/>
                                        </children>
                                    </StackPane>
                                </graphic>
                            </Button>
                        </children>
                    </StackPane>
                    <Hyperlink fx:id="linkForgotPassword"
                               text="Olvidé mi contraseña"
                               onAction="#forgotPassword"
                               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-border-color: transparent; -fx-padding: 0;"/>
                </VBox>

                <Label fx:id="lblLogin" textFill="#ff6b6b" minHeight="18.0" wrapText="true">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>

                <Button text="Iniciar Sesión"
                        fx:id="btnLogin"
                        onAction="#login"
                        defaultButton="true"
                        prefWidth="360.0" prefHeight="46.0" maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;">
                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="3.0">
            <padding>
                <Insets bottom="12.0" left="10.0" right="10.0" top="6.0"/>
            </padding>
            <children>
                <Label text="Sistema de Gestión de Formaciones en Empresa v1.0" textFill="#aaaaaa">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Label>
                <Label text="Desarrollado por Bruno Ortiz Blanco" textFill="#888888">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
            </children>
        </VBox>
    </bottom>

</BorderPane>
