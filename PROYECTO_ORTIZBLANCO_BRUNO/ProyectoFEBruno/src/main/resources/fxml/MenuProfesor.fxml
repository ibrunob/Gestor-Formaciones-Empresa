<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.72" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.brunob.ProyectoBase2025.controller.MenuProfesorController"
            stylesheets="@../styles/Menu.css">
    
    <top>
        <VBox>
            <MenuBar styleClass="menu-bar">
                <menus>
                    <Menu text="Archivo">
                        <items>
                            <MenuItem text="Cerrar Sesión" onAction="#logout"/>
                            <MenuItem text="Salir" onAction="#exit"/>
                        </items>
                    </Menu>
                    <Menu text="Estudiantes">
                        <items>
                            <MenuItem text="Ver mis estudiantes" onAction="#verEstudiantes"/>
                            <MenuItem text="Seguimiento FE" onAction="#seguimientoFE"/>
                        </items>
                    </Menu>
                    <Menu text="Empresas">
                        <items>
                            <MenuItem text="Ver empresas asignadas" onAction="#verEmpresas"/>
                            <MenuItem text="Contactar empresa" onAction="#contactarEmpresa"/>
                        </items>
                    </Menu>
                    <Menu text="Evaluación">
                        <items>
                            <MenuItem text="Calificar estudiantes" onAction="#calificarEstudiantes"/>
                            <MenuItem text="Registrar asistencia" onAction="#registrarAsistencia"/>
                        </items>
                    </Menu>
                    <Menu text="Ayuda">
                        <items>
                            <MenuItem text="Acerca de" onAction="#acercaDe"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-panel">
                <padding>
                    <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
                </padding>
                <children>
                    <ImageView fitWidth="60.0" fitHeight="60.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/logoLaboral.jpg"/>
                        </image>
                    </ImageView>
                    <VBox spacing="5.0">
                        <Label text="Panel de Profesor/Tutor" styleClass="title-header"/>
                        <Label fx:id="lblUserInfo" text="Usuario: " styleClass="subtitle-header"/>
                    </VBox>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button text="Cerrar Sesión" onAction="#logout" styleClass="btn-logout"/>
                </children>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="30.0">
            <padding>
                <Insets bottom="40.0" left="60.0" right="60.0" top="40.0"/>
            </padding>
            
            <Label text="Gestión de Formaciones en Empresa" styleClass="main-title"/>
            <Label text="Panel del Tutor Docente" styleClass="subtitle"/>
            
            <Separator prefWidth="600.0"/>
            
            <GridPane hgap="40.0" vgap="40.0" alignment="CENTER">
                <VBox styleClass="menu-card" alignment="CENTER" spacing="10.0" 
                      GridPane.columnIndex="0" GridPane.rowIndex="0"
                      onMouseClicked="#verEstudiantes">
                    <Label text="🎓" style="-fx-font-size: 48px;"/>
                    <Label text="Mis Estudiantes" styleClass="card-title"/>
                    <Label text="Ver estudiantes asignados" styleClass="card-description"/>
                </VBox>
                
                <VBox styleClass="menu-card" alignment="CENTER" spacing="10.0"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"
                      onMouseClicked="#seguimientoFE">
                    <Label text="📋" style="-fx-font-size: 48px;"/>
                    <Label text="Seguimiento FE" styleClass="card-title"/>
                    <Label text="Control de prácticas" styleClass="card-description"/>
                </VBox>
                
                <VBox styleClass="menu-card" alignment="CENTER" spacing="10.0"
                      GridPane.columnIndex="2" GridPane.rowIndex="0"
                      onMouseClicked="#verEmpresas">
                    <Label text="🏢" style="-fx-font-size: 48px;"/>
                    <Label text="Empresas" styleClass="card-title"/>
                    <Label text="Empresas colaboradoras" styleClass="card-description"/>
                </VBox>
                
                <VBox styleClass="menu-card" alignment="CENTER" spacing="10.0"
                      GridPane.columnIndex="0" GridPane.rowIndex="1"
                      onMouseClicked="#calificarEstudiantes">
                    <Label text="📝" style="-fx-font-size: 48px;"/>
                    <Label text="Calificaciones" styleClass="card-title"/>
                    <Label text="Evaluar estudiantes" styleClass="card-description"/>
                </VBox>
                
                <VBox styleClass="menu-card" alignment="CENTER" spacing="10.0"
                      GridPane.columnIndex="1" GridPane.rowIndex="1"
                      onMouseClicked="#registrarAsistencia">
                    <Label text="✅" style="-fx-font-size: 48px;"/>
                    <Label text="Asistencia" styleClass="card-title"/>
                    <Label text="Registro de faltas" styleClass="card-description"/>
                </VBox>
                
                <VBox styleClass="menu-card" alignment="CENTER" spacing="10.0"
                      GridPane.columnIndex="2" GridPane.rowIndex="1"
                      onMouseClicked="#gestionDocumentos">
                    <Label text="📁" style="-fx-font-size: 48px;"/>
                    <Label text="Documentación" styleClass="card-title"/>
                    <Label text="Gestión documental" styleClass="card-description"/>
                </VBox>
            </GridPane>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="300.0" styleClass="footer-panel">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <Label text="Sistema de Gestión FE - CIFP La Laboral v1.0"/>
                <Label text="Bruno Ortiz Blanco"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
